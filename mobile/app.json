{
  "expo": {
    "name": "Dabari",
    "slug": "dabari",
    "scheme": "dabari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#0B3B24",
      "barStyle": "light-content",
      "translucent": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dabari.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Dabari a besoin d'accéder à votre galerie pour importer des photos de vos plats traiteur et annonces GP."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.dabari.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Dabari à accéder à vos photos pour vos annonces et plats.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
