datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String?   @unique
  phone                String?   @unique
  password             String
  role                 String?   @default("client")
  is_email_verified    Boolean   @default(false)
  email_verify_code    String?
  email_verify_expires DateTime?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  profile Profile?

  @@map("users")
}

model Profile {
  id         String    @id @db.Uuid
  full_name  String
  phone      String?
  avatar_url String?
  city       String?
  role       String?   @default("client")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  whatsapp   String?
  email      String?

  // Relations
  user              User               @relation(fields: [id], references: [id], onDelete: Cascade)
  traiteurs         Traiteur[]
  orders            Order[]
  gp_listings       GpListing[]
  gp_requests       GpRequest[]
  sent_messages     Message[]          @relation("sent_messages")
  received_messages Message[]          @relation("received_messages")
  commandes         CommandeTraiteur[]
  notifications     Notification[]
  traiteur_requests TraiteurRequest[]

  @@map("profiles")
}

model Traiteur {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String?   @db.Uuid
  name           String
  bio            String?
  cuisine_type   String[]
  rating         Decimal?  @default(0) @db.Decimal
  review_count   Int?      @default(0)
  delivery_zones String[]
  image_url      String?
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  whatsapp       String?

  // Relations
  profile   Profile?           @relation(fields: [user_id], references: [id], onDelete: SetNull)
  dishes    Dish[]
  orders    Order[]
  commandes CommandeTraiteur[]
  proposals TraiteurProposal[]

  @@index([user_id])
  @@map("traiteurs")
}

model Dish {
  id              String    @id @default(uuid()) @db.Uuid
  traiteur_id     String?   @db.Uuid
  name            String
  description     String?
  price           Decimal   @db.Decimal
  image_urls      String[]
  cuisine_type    String?
  is_available    Boolean?  @default(true)
  min_order_hours Int?      @default(24)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  is_archived     Boolean?  @default(false)

  // Relations
  traiteur    Traiteur?   @relation(fields: [traiteur_id], references: [id], onDelete: SetNull)
  order_items OrderItem[]

  @@index([traiteur_id])
  @@index([is_archived, is_available])
  @@map("dishes")
}

model Order {
  id               String    @id @default(uuid()) @db.Uuid
  client_id        String?   @db.Uuid
  traiteur_id      String?   @db.Uuid
  status           String?   @default("pending")
  delivery_type    String?   @default("delivery")
  delivery_address String?
  delivery_date    DateTime? @db.Timestamptz(6)
  total_amount     Decimal?  @db.Decimal
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  // Relations
  client      Profile?    @relation(fields: [client_id], references: [id], onDelete: SetNull)
  traiteur    Traiteur?   @relation(fields: [traiteur_id], references: [id], onDelete: SetNull)
  order_items OrderItem[]

  @@index([client_id])
  @@index([traiteur_id])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  order_id   String? @db.Uuid
  dish_id    String? @db.Uuid
  quantity   Int
  unit_price Decimal @db.Decimal

  // Relations
  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)
  dish  Dish?  @relation(fields: [dish_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([dish_id])
  @@map("order_items")
}

model GpListing {
  id                String    @id @default(uuid()) @db.Uuid
  gp_id             String?   @db.Uuid
  departure_city    String
  departure_country String
  arrival_city      String
  arrival_country   String
  departure_date    DateTime  @db.Date
  arrival_date      DateTime? @db.Date
  available_kg      Decimal   @db.Decimal
  price_per_kg      Decimal   @db.Decimal
  flight_type       String?   @default("direct")
  description       String?
  is_active         Boolean?  @default(true)
  rating            Decimal?  @default(0) @db.Decimal
  review_count      Int?      @default(0)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  pickup_address    String?
  pickup_city       String?
  dropoff_address   String?
  dropoff_city      String?
  latitude          Decimal?  @db.Decimal
  longitude         Decimal?  @db.Decimal
  is_delayed        Boolean?  @default(false)
  delay_reason      String?

  // Relations
  gp       Profile?    @relation(fields: [gp_id], references: [id], onDelete: SetNull)
  requests GpRequest[]

  @@index([gp_id])
  @@index([is_active])
  @@index([departure_date])
  @@map("gp_listings")
}

model GpRequest {
  id                String    @id @default(uuid()) @db.Uuid
  listing_id        String?   @db.Uuid
  sender_id         String?   @db.Uuid
  weight_kg         Decimal   @db.Decimal
  content_desc      String
  declared_value    Decimal?  @db.Decimal
  status            String?   @default("pending")
  total_amount      Decimal?  @db.Decimal
  notes             String?
  departure_city    String?
  departure_country String?
  arrival_city      String?
  arrival_country   String?
  departure_date    DateTime? @db.Date
  arrival_date      DateTime? @db.Date
  is_delayed        Boolean?  @default(false)
  delay_reason      String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)

  // Relations
  listing GpListing? @relation(fields: [listing_id], references: [id], onDelete: SetNull)
  sender  Profile?   @relation(fields: [sender_id], references: [id], onDelete: SetNull)

  @@index([listing_id])
  @@index([sender_id])
  @@index([status])
  @@map("gp_requests")
}

model Message {
  id           String    @id @default(uuid()) @db.Uuid
  sender_id    String?   @db.Uuid
  receiver_id  String?   @db.Uuid
  content      String
  reference_id String?   @db.Uuid
  is_read      Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  // Relations
  sender   Profile? @relation("sent_messages", fields: [sender_id], references: [id], onDelete: SetNull)
  receiver Profile? @relation("received_messages", fields: [receiver_id], references: [id], onDelete: SetNull)

  @@map("messages")
}

model CommandeTraiteur {
  id               String    @id @default(uuid()) @db.Uuid
  client_id        String?   @db.Uuid
  traiteur_id      String?   @db.Uuid
  date_evenement   DateTime  @db.Date
  nb_personnes     Int
  adresse          String
  type_evenement   String?
  notes            String?
  statut           String?   @default("en_attente")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  message_traiteur String?

  // Relations
  client   Profile?  @relation(fields: [client_id], references: [id], onDelete: SetNull)
  traiteur Traiteur? @relation(fields: [traiteur_id], references: [id], onDelete: SetNull)

  @@index([client_id])
  @@index([traiteur_id])
  @@index([statut])
  @@map("commandes_traiteur")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  type       String
  titre      String
  message    String?
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  user_id    String?   @db.Uuid
  data       Json?

  // Relations
  user Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model TraiteurRequest {
  id               String             @id @default(uuid()) @db.Uuid
  client_id        String             @db.Uuid
  title            String?
  event_type       String
  guest_count      Int?
  event_date       DateTime           @db.Date
  location         String
  food_preferences String
  budget           Decimal?           @db.Decimal
  description      String?
  status           String?            @default("open")
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)

  // Relations
  client           Profile            @relation(fields: [client_id], references: [id], onDelete: Cascade)
  proposals        TraiteurProposal[]

  @@index([client_id])
  @@index([status])
  @@map("traiteur_requests")
}

model TraiteurProposal {
  id             String          @id @default(uuid()) @db.Uuid
  request_id     String          @db.Uuid
  traiteur_id    String          @db.Uuid
  proposed_price Decimal         @db.Decimal
  message        String
  status         String?         @default("pending")
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)

  // Relations
  request        TraiteurRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  traiteur       Traiteur        @relation(fields: [traiteur_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@index([traiteur_id])
  @@index([status])
  @@map("traiteur_proposals")
}
